{
  "name": "xenia-backend",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "mock": "tsx mock/server.ts",
    "test": "NODE_OPTIONS=--experimental-sqlite tsx --test \"test/*.test.ts\" \"../shared/test/*.test.ts\"",
    "test:watchdog": "tsx --test ../shared/test/brew-watchdog.test.ts",
    "test:arming": "tsx --test ../shared/test/bbw-arming.test.ts",
    "test:profile-temp": "tsx --test ../shared/test/profile-temp.test.ts",
    "test:profile-reset": "tsx --test ../shared/test/profile-temp-reset.test.ts",
    "test:script-timeline": "tsx --test ../shared/test/script-timeline.test.ts",
    "test:script-overlay": "tsx --test ../shared/test/script-overlay.test.ts",
    "test:brew-phase": "tsx --test ../shared/test/brew-phase.test.ts",
    "test:coffee-age": "tsx --test ../shared/test/coffee-age.test.ts",
    "test:bean-remaining": "tsx --test ../shared/test/bean-remaining.test.ts",
    "test:bean-stock-alert": "tsx --test ../shared/test/bean-stock-alert.test.ts",
    "test:best-brew": "NODE_OPTIONS=--experimental-sqlite tsx --test test/best-brew.test.ts",
    "test:ghosts": "NODE_OPTIONS=--experimental-sqlite tsx --test test/shot-ghosts.test.ts",
    "test:coffee-image": "NODE_OPTIONS=--experimental-sqlite tsx --test test/coffee-image.test.ts",
    "test:i18n": "tsx --test test/i18n-keys.test.ts",
    "test:pi": "tsx --test ../shared/test/pi-controller.test.ts",
    "test:flowhold": "tsx --test test/flow-hold-driver.test.ts",
    "test:recorder-drive": "NODE_OPTIONS=--experimental-sqlite tsx --test test/recorder-drive-finalize.test.ts",
    "test:start-gate": "NODE_OPTIONS=--experimental-sqlite tsx --test test/start-gate.test.ts",
    "test:stop-generation": "NODE_OPTIONS=--experimental-sqlite tsx --test test/stop-generation.test.ts",
    "test:body-validation": "NODE_OPTIONS=--experimental-sqlite tsx --test test/body-validation.test.ts",
    "test:ws-snapshot": "tsx --test test/ws-snapshot.test.ts",
    "test:stop-routing": "tsx --test test/stop-routing.test.ts",
    "test:profile-invariants": "tsx --test test/profile-invariants.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.12.7",
    "pino-pretty": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
